# Backend Dockerfile
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    wireless-tools \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend code
COPY backend/ .
COPY .env.example .env

# Create directories
RUN mkdir -p logs models/checkpoints datasets/{raw,processed,labeled}

EXPOSE 8000 8001

CMD ["python", "main.py"]
